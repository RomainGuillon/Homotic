# Variables d'environnement d'Homotic en production.
#
#   sudo cp deploiement/homotic.env.exemple /etc/homotic.env
#   sudo chmod 600 /etc/homotic.env
#   sudo nano /etc/homotic.env
#
# Format systemd : CLE=valeur, pas de guillemets, pas d'espaces autour du « = ».

# Cle de signature des sessions et des jetons CSRF. A generer une seule fois :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# La changer deconnecte tout le monde ; la divulguer permet de se faire
# passer pour n'importe quel utilisateur.
HOMOTIC_SECRET_KEY=REMPLACER_PAR_UNE_CLE_GENEREE

# Jamais « 1 » sur un serveur joignable depuis Internet : les pages d'erreur
# de Django affichent alors la configuration complete, cles comprises.
HOMOTIC_DEBUG=0

# Noms sous lesquels l'application accepte d'etre appelee.
HOMOTIC_HOSTS=homotic.rodica-romain.fr,127.0.0.1,localhost

# Origines de confiance pour les formulaires (schema compris).
HOMOTIC_ORIGINES=https://homotic.rodica-romain.fr
